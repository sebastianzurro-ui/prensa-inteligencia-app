# =============================================================
# CONFIGURACIÓN PARA PRODUCCIÓN
# Copiá esto a .env.local en tu computadora
# =============================================================

# --- MODO ---
# mock = datos de ejemplo (sin API keys)
# real = datos reales de Supabase + LLM
VITE_LLM_MODE=mock

# --- LLM (Groq es gratis y rápido) ---
VITE_LLM_PROVIDER=groq
VITE_GROQ_API_KEY=tu_clave_de_groq_aca
VITE_GROQ_MODEL=llama-3.3-70b-versatile

# --- Supabase ---
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_clave_anon_de_supabase_aca

# --- Edge Functions (producción segura) ---
# Dejar vacío para modo directo (keys en cliente)
# Completar con la URL de tu proyecto Supabase para modo seguro
VITE_EDGE_FUNCTION_URL=
